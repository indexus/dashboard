{
  "name": "@indexus/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c teal,cyan \"node server.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "test": "node --test lib/*.test.mjs src/lib/indexus/**/*.test.mjs",
    "load-dvf": "node scripts/load_dvf.js --year 2020",
    "load-dvf:sample": "node scripts/load_dvf.js --year 2020 --limit 5000",
    "load-density": "node scripts/load_density.js --count 40000",
    "load-density:sample": "node scripts/load_density.js --count 5000"
  },
  "dependencies": {
    "@indexus/rendering-map": "file:../sdk-js-rendering/map",
    "axios": "^1.7.9",
    "buffer": "^6.0.3",
    "csv-parser": "^3.2.1",
    "d3": "^7.9.0",
    "earcut": "^3.2.3",
    "js-indexus-sdk": "link:../sdk-js",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "vite": "^5.4.10"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
